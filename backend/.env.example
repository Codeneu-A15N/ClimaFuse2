# -----------------------------------------------------------------------------
# ClimaFuse Backend — Environment Configuration (.env.example)
# -----------------------------------------------------------------------------

# API & Server Settings
PROJECT_NAME="ClimaFuse BMA Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Connection (MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=climafuse
MYSQL_PASSWORD=climafuse_pass
MYSQL_DATABASE=climafuse
# Optional full connection URL (overrides individual params if provided)
# DATABASE_URL=mysql+pymysql://climafuse:climafuse_pass@localhost:3306/climafuse

# Cache Directories
CACHE_DIR=backend/cache
AIFS_CACHE_DIR=backend/cache/aifs
GFS_CACHE_DIR=backend/cache/gfs
IMD_CACHE_DIR=backend/cache/imd

# Model Data Products (Herbie)
AIFS_MODEL=aifs
AIFS_PRODUCT=oper
GFS_MODEL=gfs
GFS_PRODUCT=pgrb2.0p25

# BMA Calibration Period (2025 Historical Data)
# Deterministic AIFS became operational on 2025-02-25.
# Pre-operational data (Jan 1 - Feb 24, 2025) is strictly excluded.
BMA_TRAIN_START=2025-02-25
BMA_TRAIN_END=2025-09-30
BMA_TEST_START=2025-10-01
BMA_TEST_END=2025-12-31

# BMA Sample Count Thresholds per Fallback Level
MIN_SAMPLES_L1=300
MIN_SAMPLES_L2=300
MIN_SAMPLES_L3=300
MIN_SAMPLES_L4=150
MIN_SAMPLES_L5=100
