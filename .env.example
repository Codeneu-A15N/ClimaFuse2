# ClimaFuse Environment Variables

# Backend API
VITE_API_BASE_URL=http://localhost:8000

# Geospatial Map Tile Configuration (Optional)
# ClimaFuse renders high-resolution Physical Topographic Map of India (Image 2 style)
# out-of-the-box using open ESRI World Physical Map tiles (ZERO API key required).
#
# If you want to use custom MapTiler vector styles (Topo-v2, Outdoor, 3D Terrain-RGB):
# 1. Sign up for free at https://www.maptiler.com/ (Free tier: 100k requests/month)
# 2. Add your key below:
# VITE_MAPTILER_KEY=your_maptiler_api_key_here
